."},"fullyImplemented":true,"linearizedBaseContracts":[9627,8767],"name":"ChainlinkOracleAdapter","nameLocation":"1216:22:30","scope":9628,"usedErrors":[9491,9495],"usedEvents":[]}],"license":"MIT"},"id":30}